# Banco de dados (Postgres — Neon ou Vercel Postgres)
DATABASE_URL="postgresql://user:password@host-pooler:5432/smebarauna?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/smebarauna?sslmode=require"

# JWT
JWT_SECRET="troque-por-um-segredo-forte-de-32-bytes"

# API SIGEduc (Educ 21)
SIGEDUC_API_BASE_URL="https://api.educ21.com.br"
SIGEDUC_API_KEY="coloque-a-chave-aqui"
SIGEDUC_CLIENT_ID="barauna-rn"

# Conta ADMIN inicial criada por `npm run db:seed`
SEED_ADMIN_CPF="00000000000"
SEED_ADMIN_PASSWORD="troque-esta-senha"

# Vercel Blob (upload de imagens de capa e documentos PDF)
BLOB_READ_WRITE_TOKEN="coloque-o-token-aqui"

# Autentica os Vercel Cron Jobs em /api/cron/*
CRON_SECRET="gere-um-segredo-aleatorio-forte"
