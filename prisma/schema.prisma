datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SECRETARIA
  DIRETOR
  PROFESSOR
  SERVIDOR_GERAL
  ALUNO
}

enum CategoriaPost {
  NOTICIA
  AVISO
  DESTAQUE
  DOCUMENTO
}

enum TipoAvaliacao {
  FLUENCIA_LEITORA
  SPADEB
  SIMULADO
  PROVA_MUNICIPAL
  AVALIACAO_CONTINUA_CAED
}

enum NivelFluencia {
  NAO_LEITOR
  LEITOR_DE_SILABAS
  LEITOR_DE_PALAVRAS
  LEITOR_DE_FRASES
  LEITOR_SEM_FLUENCIA
  LEITOR_FLUENTE
}

model User {
  id            String    @id @default(cuid())
  cpf           String    @unique
  nome          String
  email         String?
  passwordHash  String
  role          Role      @default(ALUNO)
  escolaId      Int?
  servidorId    Int?
  estudanteId   Int?
  ativo         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  posts         Post[]
}

model Escola {
  id          Int          @id // ID do SIGEduc
  nome        String
  codigoInep  String?
  endereco    String?
  telefone    String?
  servidores  Servidor[]
  estudantes  Estudante[]
  avaliacoesResultados AvaliacaoResultadoAluno[]
  avaliacoesResultadosTurma AvaliacaoResultadoTurma[]
  servidorTurmas ServidorTurma[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Cargo {
  id          Int        @id // ID do SIGEduc
  categoria   String?
  denominacao String
  nivelCargo  String?
}

model Servidor {
  id                  Int             @id @default(autoincrement())
  cpf                 String          @unique
  matricula           String?
  nome                String
  dataNascimento      String?
  sexo                String?
  cargo               String?
  funcao              String?
  tipoVinculo         String?
  status              String?         @default("Ativo")
  pendenciaPedagogica String?
  email               String?
  telefone            String?
  // Fallback de lotação funcional para quando a origem não traz turma
  // (cargos administrativos) — a API manda turno/carga_trabalho na própria
  // linha do servidor, mas antes da ETAPA 08 esses valores só eram
  // persistidos em ServidorTurma, e portanto descartados quando não havia
  // turma. Não usar para atribuição pedagógica: quando o servidor tem
  // turma(s), a fonte de verdade continua sendo ServidorTurma.turno/
  // cargaTrabalho (podem variar por turma).
  turno               String?
  cargaTrabalho       Int?
  escolaId            Int?
  escola              Escola?         @relation(fields: [escolaId], references: [id])
  escolaNome          String?
  turmas              ServidorTurma[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

// Uma linha por (servidor × turma) lecionada/atribuída — a origem
// (SIGEduc) pagina servidores exatamente nessa granularidade, então um
// servidor com várias turmas aparece em várias linhas. Isolar isso do
// Servidor evita que o sync sobrescreva a turma de um professor a cada
// nova turma processada (só a última sobrevivia antes desta tabela).
model ServidorTurma {
  id            String   @id @default(cuid())
  servidorId    Int
  servidor      Servidor @relation(fields: [servidorId], references: [id], onDelete: Cascade)
  // Escola da turma nesta linha — a origem (SIGEduc) já entrega isso por
  // linha (mesmo codigo_inep_escola usado para resolver Servidor.escolaId),
  // mas antes da ETAPA 06 esse dado era descartado ao gravar ServidorTurma.
  // Necessário porque Servidor.escolaId é único por servidor e pode não
  // refletir a escola de CADA turma quando o professor atua em mais de uma
  // unidade (ver decisão técnica na ETAPA 06).
  escolaId      Int
  escola        Escola   @relation(fields: [escolaId], references: [id])
  turma         String
  serie         String?
  turno         String?
  disciplina    String?
  cargaTrabalho Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([servidorId, escolaId, turma])
  @@index([servidorId])
  @@index([escolaId])
}

model Estudante {
  id                        Int         @id // ID do SIGEduc
  matricula                 String      @unique
  cpf                       String?
  nome                      String
  dataNascimento            String?
  ano                       Int
  turmaSerie                String?
  escolaId                  Int
  escola                    Escola      @relation(fields: [escolaId], references: [id])
  nomeEscola                String?
  nomeFiliacao1             String?
  nomeFiliacao2             String?
  nomeResponsavel           String?
  documentoResponsavel      String?
  codigoNis                 String?
  notas                     NotaEstudante[]
  frequencias               FrequenciaEstudante[]
  avaliacoesResultados      AvaliacaoResultadoAluno[]
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
}

model NotaEstudante {
  id                 String     @id @default(cuid())
  estudanteMatricula String
  estudante          Estudante  @relation(fields: [estudanteMatricula], references: [matricula], onDelete: Cascade)
  ano                Int
  escola             String?
  etapaEnsino        String?
  serie              String?
  turma              String?
  disciplina         String
  unidade            Int
  nota               Float
  descricao          String?
  createdAt          DateTime   @default(now())

  @@unique([estudanteMatricula, ano, disciplina, unidade], name: "notaEstudanteUnica")
  @@index([estudanteMatricula, ano])
}

model FrequenciaEstudante {
  id                 String     @id @default(cuid())
  estudanteMatricula String
  estudante          Estudante  @relation(fields: [estudanteMatricula], references: [matricula], onDelete: Cascade)
  data               String
  disciplina         String?
  turma              String?
  etapaEnsino        String?
  // Escola no momento do registro (API manda em `unidade`) — sem isso não dá pra atribuir
  // frequência histórica à escola certa quando o aluno já trocou de escola. Nulo em
  // registros sincronizados antes desta coluna existir.
  escola             String?
  // Série no momento do registro (API manda em `serie`) — mesmo motivo da coluna `escola` acima.
  serie              String?
  falta              Int        @default(0)
  quantidadeAula     Int        @default(1)
  abonada            Boolean    @default(false)
  motivoAbono        String?
  createdAt          DateTime   @default(now())

  @@unique([estudanteMatricula, data, disciplina], name: "frequenciaEstudanteUnica")
  @@index([estudanteMatricula, data])
}

model Post {
  id             String         @id @default(cuid())
  titulo         String
  slug           String         @unique
  resumo         String?
  conteudo       String         @db.Text
  imagemCapa     String?
  galeriaImagens String[]
  categoria      CategoriaPost  @default(NOTICIA)
  destaque       Boolean        @default(false)
  importante     Boolean        @default(false)
  publicado      Boolean        @default(true)
  dataPublicacao DateTime       @default(now())
  autorId        String?
  autor          User?          @relation(fields: [autorId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model DocumentoPublico {
  id          String   @id @default(cuid())
  titulo      String
  categoria   String
  descricao   String?
  arquivoUrl  String
  tamanho     String?
  acessos     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model IndicadoresLanding {
  id              String   @id @default("default")
  totalEscolas    Int      @default(20)
  totalAlunos     Int      @default(3800)
  totalDocumentos Int      @default(150)
  totalAcessos    Int      @default(12500)
  updatedAt       DateTime @updatedAt
}

model Avaliacao {
  id          String         @id @default(cuid())
  codigo      String         @unique
  nome        String
  descricao   String?
  tipo        TipoAvaliacao  @default(FLUENCIA_LEITORA)
  ano         Int
  etapaEnsino String?
  ativo       Boolean        @default(true)
  questoes    AvaliacaoQuestao[]
  resultados  AvaliacaoResultadoAluno[]
  resultadosTurma AvaliacaoResultadoTurma[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model AvaliacaoQuestao {
  id              String    @id @default(cuid())
  avaliacaoId     String
  avaliacao       Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  numero          Int
  enunciado       String?
  descritor       String?
  gabaritoCorreto String?
  peso            Float     @default(1.0)
}

model AvaliacaoResultadoAluno {
  id               String         @id @default(cuid())
  avaliacaoId      String
  avaliacao        Avaliacao      @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  estudanteId      Int
  estudante        Estudante      @relation(fields: [estudanteId], references: [id], onDelete: Cascade)
  escolaId         Int
  escola           Escola         @relation(fields: [escolaId], references: [id])
  turma            String
  pontuacao        Float?
  nivelDesempenho  NivelFluencia?
  palavrasPorMin   Int?
  respostasJson    Json?
  observacoes      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([avaliacaoId, estudanteId])
}

// Resultado agregado por turma — usado por fontes externas que só
// publicam indicadores no nível de turma/escola, sem identificar aluno
// (ex.: Avaliação Contínua da Aprendizagem do CAEd/Criança Alfabetizada).
model AvaliacaoResultadoTurma {
  id                      String    @id @default(cuid())
  avaliacaoId             String
  avaliacao               Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  escolaId                Int
  escola                  Escola    @relation(fields: [escolaId], references: [id])
  turma                   String
  percentualParticipacao  Float?
  percentualDefasagem     Float?
  percentualIntermediario Float?
  percentualAdequado      Float?
  acertoPorHabilidade     Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([avaliacaoId, escolaId, turma])
}

model LogSincronizacao {
  id          String   @id @default(cuid())
  modulo      String
  status      String
  registros   Int      @default(0)
  mensagem    String?
  duracaoMs   Int?
  createdAt   DateTime @default(now())
}
